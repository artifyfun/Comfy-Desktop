{
  "name": "artify-desktop",
  "version": "1.17.0",
  "description": "Artify Desktop - Make AI easier to use.",
  "author": {
    "name": "ArtifyFun",
    "email": "artifyfun@artify.fun",
    "url": "https://artify.fun"
  },
  "repository": "github:artifyfun/Comfy-Desktop",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/artifyfun/Comfy-Desktop",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.1",
  "main": "./out/main/index.js",
  "scripts": {
    "init": "pnpm install && pnpm run bootstrap",
    "init:dev": "pnpm run init && pnpm run dev",
    "predev": "node -e \"const fs=require('fs'),p=process.platform==='win32'?'win-'+process.arch:process.platform==='darwin'?'mac-arm64':'linux-'+process.arch;if(!fs.existsSync('bootstrap-python/'+p))console.log('\\n\\x1b[33m⚠ Bootstrap python not found. Run \\\"pnpm run bootstrap\\\" for pre-install git support.\\x1b[0m\\n')\"",
    "dev": "node scripts/dev.mjs",
    "predev:bootstrap": "node -e \"const fs=require('fs'),p=process.platform==='win32'?'win-'+process.arch:process.platform==='darwin'?'mac-arm64':'linux-'+process.arch;if(!fs.existsSync('bootstrap-python/'+p)){console.log('Building bootstrap python...');require('child_process').execSync('node scripts/build-bootstrap-python.mjs',{stdio:'inherit'})}\"",
    "dev:bootstrap": "node -e \"process.env.COMFY_FORCE_BOOTSTRAP_GIT='1';require('child_process').execSync('electron-vite dev',{stdio:'inherit',env:process.env})\"",
    "build": "node scripts/copy-codex-bin.mjs && pnpm run build:frontend && pnpm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "node ./scripts/postinstall.mjs",
    "todesktop:beforeInstall": "./scripts/todesktop-beforeInstall.cjs",
    "todesktop:beforeBuild": "./scripts/todesktop-beforeBuild.cjs",
    "todesktop:afterPack": "./scripts/todesktop-afterPack.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:e2e",
    "build:unpack": "pnpm run build && pnpm run clean:dist-resources && electron-builder --dir",
    "build:win": "pnpm run build && pnpm run clean:dist-resources && electron-builder --win",
    "build:mac": "pnpm run build && pnpm run clean:dist-resources && electron-builder --mac",
    "build:linux": "pnpm run build && pnpm run clean:dist-resources && electron-builder --linux",
    "bootstrap": "node scripts/build-bootstrap-python.mjs",
    "bootstrap:fetch": "node scripts/fetch-bootstrap-python.mjs",
    "bridge-types:gen": "pnpm exec tsc -p tsconfig.comfy-desktop-bridge-types.json && pnpm exec prettier --write \"packages/comfyui-desktop-bridge-types/*.d.ts\"",
    "bridge-types:check": "pnpm run bridge-types:gen && git add --intent-to-add -- 'packages/comfyui-desktop-bridge-types/*.d.ts' && git diff --exit-code -- 'packages/comfyui-desktop-bridge-types/*.d.ts'",
    "font:fetch": "node scripts/fetch-font.mjs",
    "sandbox:gen": "node scripts/generate-sandbox.mjs",
    "datadog:sourcemaps:upload": "node ./scripts/upload-datadog-sourcemaps.mjs",
    "lint": "eslint . && cd packages/frontend && npx eslint src",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:macos": "playwright test --project=macos",
    "test:e2e:windows": "playwright test --project=windows",
    "test:e2e:hardware-acceleration": "playwright test --project=windows e2e/hardware-acceleration.test.ts",
    "test:e2e:linux": "playwright test --project=linux",
    "test:watch": "vitest",
    "prepare": "node ./scripts/prepare.mjs",
    "build:frontend": "pnpm --filter artifylab-frontend run build:desktop",
    "clean:dist-resources": "node scripts/clean-dist-resources.mjs",
    "preview": "node scripts/preview/serve.mjs --open",
    "preview:shots": "node scripts/preview/shots.mjs",
    "test:browser:install": "playwright install --only-shell chromium",
    "test:e2e:macos:focus": "playwright test --project=macos-focus --pass-with-no-tests",
    "test:e2e:windows:focus": "playwright test --project=windows-focus --pass-with-no-tests",
    "test:e2e:real-comfy": "playwright test --project=real-comfy",
    "test:e2e:real-comfy:install": "playwright test --project=real-comfy e2e/real-comfy.test.ts --grep \"@sec-setup|@sec-meta\"",
    "test:e2e:real-comfy:models": "playwright test --project=real-comfy e2e/real-comfy.test.ts --grep \"@sec-setup|@sec-models\"",
    "test:e2e:real-comfy:update": "playwright test --project=real-comfy e2e/real-comfy.test.ts --grep \"@sec-setup|@sec-meta|@sec-update\"",
    "test:e2e:real-comfy:crosschannel": "playwright test --project=real-comfy e2e/real-comfy.test.ts --grep \"@sec-setup|@sec-meta|@sec-crosschannel\"",
    "test:e2e:real-comfy:snapshot": "playwright test --project=real-comfy e2e/real-comfy.test.ts --grep \"@sec-setup|@sec-meta|@sec-snapshot\"",
    "test:e2e:real-comfy:manager": "playwright test --project=real-comfy e2e/real-comfy.test.ts --grep \"@sec-setup|@sec-meta|@sec-manager\"",
    "test:e2e:real-comfy:picker": "playwright test --project=real-comfy e2e/real-comfy.test.ts --grep \"@sec-setup|@sec-meta|@sec-picker\"",
    "test:e2e:real-comfy:bootwindow": "playwright test --project=real-comfy e2e/real-comfy.test.ts --grep \"@sec-setup|@sec-meta|@sec-bootwindow\"",
    "test:e2e:real-comfy:copy": "playwright test --project=real-comfy e2e/real-comfy.test.ts --grep \"@sec-setup|@sec-meta|@sec-copy\"",
    "test:e2e:real-comfy:remote": "playwright test --project=real-comfy e2e/real-comfy.test.ts --grep \"@sec-setup|@sec-meta|@sec-remote\"",
    "test:e2e:real-comfy:delete": "playwright test --project=real-comfy e2e/real-comfy.test.ts --grep \"@sec-setup|@sec-meta|@sec-delete\""
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@datadog/browser-rum": "7.17.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@ngrok/ngrok": "^1.5.1",
    "@ngrok/ngrok-win32-x64-msvc": "1.7.0",
    "@todesktop/runtime": "^2.1.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@zed-industries/agent-client-protocol": "^0.4.5",
    "agent-skills-ts-sdk": "^2.4.2",
    "body-parser": "^2.2.0",
    "connect-history-api-fallback": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "electron-log": "^5.4.4",
    "electron-store": "8.2.0",
    "electron-updater": "^6.8.11",
    "eventsource-parser": "^4.1.1",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "multer": "^2.4.0",
    "nanoid": "^6.0.1",
    "node-pty": "^1.1.0",
    "png-chunks-extract": "^1.0.0",
    "posthog-node": "^5.73.1",
    "semver": "^7.8.6",
    "smol-toml": "^1.9.1",
    "systeminformation": "^5.33.22",
    "tar": "^7.5.23",
    "undici": "^8.10.2",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.4.3",
    "@typeform/embed": "^6.1.2",
    "image-size": "^2.1.0",
    "music-metadata": "^12.5.0"
  },
  "devDependencies": {
    "@comfyorg/design-system": "1.3.0-alpha.1",
    "@datadog/datadog-ci": "^5.27.0",
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@openai/codex": "0.149.1",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/body-parser": "^1.19.6",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/server-renderer": "^3.5.42",
    "@vue/test-utils": "^2.6.0",
    "@vueuse/core": "^14.4.0",
    "cross-env": "^10.1.0",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lucide-vue-next": "^0.525.0",
    "pinia": "^4.1.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-component-type-helpers": "^3.3.14",
    "vue-eslint-parser": "^10.4.2",
    "vue-i18n": "^11.4.20",
    "vue-tsc": "^3.3.14",
    "@lucide/vue": "^1.73.0",
    "@tanstack/vue-virtual": "^3.13.52",
    "@types/three": "^0.186.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vue/devtools-api": "^8.2.1",
    "three": "^0.186.1"
  }
}
